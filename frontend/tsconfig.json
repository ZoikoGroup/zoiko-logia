{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // vitest.config.ts is excluded because vitest ships its own copy of vite,
  // and the two Plugin types are structurally incompatible — type-checking it
  // here fails `next build` over a mismatch in tooling that never reaches the
  // bundle. Vitest reads its own config at runtime; the tests themselves ARE
  // still type-checked.
  "exclude": ["node_modules", "vitest.config.ts"]
}
