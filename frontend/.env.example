# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Only the anon/public key belongs here — never
# the service role key, and never DATABASE_URL/APP_DATABASE_URL or backend
# feature flags (ENABLE_RAG_EMBEDDINGS, ENABLE_ML_CLASSIFIER, etc.) — those
# are backend-only and live in backend/.env instead.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Single sign-on buttons on the sign-in card, comma-separated: google, azure
# (Microsoft). Each provider must also be enabled in Supabase → Auth →
# Providers, with <origin>/auth/callback as an allowed redirect URL.
# NEXT_PUBLIC_AUTH_PROVIDERS=google,azure
# Hide the sign-up form for an invite-only deployment. The backend's
# ALLOW_PUBLIC_SIGNUP=false is the actual control; this only hides the UI.
# NEXT_PUBLIC_ALLOW_SIGNUP=false
