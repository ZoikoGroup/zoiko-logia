{
  "$id": "urn:zoikologia:qa:execution:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[A-L][0-9]{2}$",
      "type": "string"
    },
    "completed_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_ref": {
      "type": "string"
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "fixture_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "grade": {
      "maximum": 4,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "human_reviewer": {
      "type": "string"
    },
    "model_revision": {
      "type": "string"
    },
    "policy_event_ref": {
      "type": "string"
    },
    "repetition": {
      "minimum": 1,
      "type": "integer"
    },
    "required_oracles_pass": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_release": {
      "type": "string"
    },
    "started_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "INCONCLUSIVE"
      ]
    },
    "tenant_token": {
      "type": "string"
    },
    "tool_trace_ref": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "repetition",
    "fixture_sha256",
    "model_revision",
    "status",
    "grade",
    "required_oracles_pass",
    "evidence_ref",
    "started_at_utc",
    "completed_at_utc"
  ],
  "type": "object"
}
