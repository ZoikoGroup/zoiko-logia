{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoiko.example/internal/report-manifest.v1.schema.json",
  "title": "Proposed ReportManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "revision",
    "state",
    "source_snapshots",
    "rule_pack_id",
    "calc_engine_version",
    "template_version",
    "rendered_artifacts",
    "audit_commit_id"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "UNAVAILABLE",
        "DRAFT_INCOMPLETE",
        "DRAFT_RECONCILED",
        "REVIEW_PENDING",
        "REVIEWED",
        "APPROVED_FOR_ISSUE",
        "ISSUED"
      ]
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rule_pack_id": {
      "type": "string"
    },
    "rule_pack_sha256": {
      "type": "string"
    },
    "filing_taxonomy_id": {
      "type": "string"
    },
    "fx_rate_set_id": {
      "type": "string"
    },
    "account_map_version": {
      "type": "string"
    },
    "calc_engine_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "audit_commit_id": {
      "type": "string"
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rendered_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "sha256"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
