# Use the Session Pooler string from Supabase (Project Settings → Database →
# Connection String → "Session pooler"), not the direct db.<ref>.supabase.co
# host — that one is IPv6-only and unreliable on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Non-superuser role for request-time queries (auto-created on first boot).
APP_DATABASE_URL=postgresql://zoiko_app.<project-ref>:<a-password-you-choose>@aws-0-<region>.pooler.supabase.com:5432/postgres

ENABLE_ML_CLASSIFIER=true

# Testing only — see warning in RUNNING_KRITON.md.
FORCE_DIRECT_ANSWER=true

# Supabase Auth — Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is
# secret: server-side only, never send it to the frontend. This block is
# REQUIRED for real auth: with it unset, token verification fails closed
# (every authenticated endpoint 401s) and default-user seeding is silently
# skipped. SUPABASE_URL must point at the SAME project the frontend uses
# (frontend/.env → NEXT_PUBLIC_SUPABASE_URL). Accepts legacy JWT or the newer
# sb_secret_* opaque key format.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Make missing Supabase config a HARD startup failure (staging/prod). Set true
# so a dropped/misconfigured key aborts the deploy loudly at the gateway
# instead of surfacing later as a wall of 401s. Leave false for local/dev
# (soft warning + skip-seeding is intentional for plain-SQLite/frontend-only
# work).
REQUIRE_SUPABASE_CONFIG=false

# console.groq.com
GROQ_API_KEY=<gsk_...>
# Model used for answer composition. If Groq returns "model_decommissioned",
# check console.groq.com/docs/models. The current default is set once, in the
# "Optional fallback providers" block at the end of this file — declare it in
# exactly one place, so the documented default cannot drift into two different
# answers in this file.

# Google Gemini (aistudio.google.com). When set, Gemini answers questions
# (more reliable charts/diagrams) and Groq becomes the fallback + risk
# classifier. Leave GEMINI_API_KEY blank to keep answering on Groq.
# Use a model id your key can access: models?key=<key> — e.g. gemini-2.5-flash.
GEMINI_API_KEY=<AI...>
GEMINI_MODEL=gemini-flash-latest

# SearXNG instance for live web-search grounding (Ask Kriton sources).
# Run one locally: docker run -d -p 8888:8080 searxng/searxng (enable the
# JSON format in its settings.yml). Leave default if running via docker-compose.
SEARXNG_URL=http://localhost:8888
# Set true to only ever use trusted-domain results (no general-web fallback).
SEARXNG_STRICT_ALLOWLIST=false
# How long a search result stays reusable. 0 disables the cache entirely,
# which means every repeat question goes back out to Google/DuckDuckGo through
# SearXNG — the pattern that got the instance blocked. Leave it on.
SEARXNG_CACHE_TTL_SECONDS=3600
# The cache lives in Redis so it survives `--reload` and container restarts.
# DB 3: 0 and 1 are Celery's queue and results, 2 is the rate limiter. Falls
# back to REDIS_URL, then to this default. Compose overrides it with the
# service name. An unreachable cache fails open — searches still run, they
# just stop being deduplicated, so check this is set before blaming the engines.
SEARXNG_CACHE_REDIS_URL=redis://localhost:6379/3

# Exact-figure grounding — free, keyless, public URLs (no API key needed).
# DBnomics aggregates ~90 official statistics providers (World Bank, IMF, OECD,
# ECB, ILO…) for economic figures; Frankfurter serves ECB currency rates.
DBNOMICS_API_BASE_URL=https://api.db.nomics.world/v22
FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev/v1

# FX for currencies the ECB does not publish (AED, SAR, NGN, EGP, PKR…). A
# MARKET rate, not a reference rate, and every source built from it says so —
# Frankfurter stays primary and this only runs when Frankfurter has nothing.
# Keyless; override only for a proxy/test.
OPEN_ER_API_BASE_URL=https://open.er-api.com/v6

# Bank of England — UK Bank Rate from the official IADB database (series
# IUDBEDR). Keyless. Their CDN answers httpx's default User-Agent with a 403
# Access Denied page, so an identifying one is required to get a response at
# all. Unlike the SEC this is a technical requirement rather than an access
# policy, so a working default ships in the code and this only overrides the
# contact details shown to them.
BOE_API_BASE_URL=https://www.bankofengland.co.uk/boeapps/database
# BOE_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# Bank of Canada — official Canadian policy rate (Valet series V39079).
# Keyless. Override only for a proxy/test or to identify your app.
BANK_OF_CANADA_API_BASE_URL=https://www.bankofcanada.ca/valet
# BANK_OF_CANADA_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# Reserve Bank of Australia — official cash rate (statistical table F1, CSV).
# Keyless. Override only for a proxy/test or to identify your app.
RBA_CASH_RATE_CSV_URL=https://www.rba.gov.au/statistics/tables/csv/f1-data.csv
# RBA_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# Australian Bureau of Statistics — national CPI and unemployment from ABS's
# OWN Data API (data.api.abs.gov.au). Keyless; the separate ABS Indicator API
# needs a key and is deliberately not used. Override only for a proxy/test.
ABS_API_BASE_URL=https://data.api.abs.gov.au
ABS_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# Central Statistics Office of Ireland — national CPI via PxStat (JSON-stat).
# Keyless. Override only for a proxy/test or to identify your app.
CSO_API_BASE_URL=https://ws.cso.ie/public/api.restful/PxStat.Data.Cube_API.ReadDataset
CSO_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# US Treasury Fiscal Data — daily debt to the penny + Monthly Treasury
# Statement. Keyless. Override only for a proxy/test or to identify your app.
TREASURY_API_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service
TREASURY_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com

# Keyless market-index levels (S&P 500, FTSE 100, TSX Composite, ASX 200,
# ISEQ) from Yahoo Finance's public chart endpoint. The key-gated market
# providers cannot quote indices on the configured tiers; this is the source
# that actually can. Override only for a proxy/test.
YAHOO_INDEX_API_BASE_URL=https://query1.finance.yahoo.com/v8/finance

# The SAME Yahoo host also serves company equities, but through a SEPARATE
# adapter that is deliberately opt-in: the other market providers are enabled by
# their API keys, so an operator who has configured none of them is promised no
# market data at all. A keyless provider that reported itself configured would
# break that promise silently, so equities stay off until asked for explicitly.
# Leave both blank/0 to keep company quotes on the key-gated providers only.
# YAHOO_EQUITY_ENABLED=1
# YAHOO_EQUITY_API_BASE_URL=https://query1.finance.yahoo.com

# GOV.UK — official UK tax rates and guidance via the Content API. Keyless.
# NOTE: GOV.UK never deletes a page, it republishes the same slug and leaves
# the old one answering 200 forever, so a page is only used if GOV.UK reports
# it as updated within this window. Twelve months is set for a Budget cycle.
# Anything staler is refused rather than reported as a current rate — a stale
# page answers in confident prose with a live gov.uk URL, which is the worst
# failure available to a tax answer.
GOVUK_API_BASE_URL=https://www.gov.uk
GOVUK_MAX_AGE_MONTHS=12

# Official UK legislation. Public and keyless; override only for a proxy/test.
#
# KNOWN BLOCK from some egress networks (observed from this deployment's
# address, not universally): CloudFront answers every request with HTTP 202,
# an empty body and `x-cache: Error from cloudfront`, which the connector reads
# as "no result". The base URL is correct; nothing about the request is wrong.
# If legislation questions come back empty, check the status code and headers
# before changing anything here — a proxy on the egress path is the usual
# cause, and the connector degrades to SearXNG in the meantime.
LEGISLATION_API_BASE_URL=https://www.legislation.gov.uk

# SEC EDGAR — US registrants' own filed financials (revenue, net income, total
# assets, EPS…), taken from their 10-K XBRL facts. Free and keyless, but the
# SEC's access policy REQUIRES a User-Agent naming you with real contact
# details, and blocks traffic without one. Set this to your own app + email;
# left blank, the connector stays silent rather than risking an IP-level block
# on a shared egress address.
# Format: "<Company or app name> <admin-contact-email>", e.g.
#   SEC_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com
# Must be a real, monitored mailbox — it is how the SEC contacts you before
# blocking. Left blank (as here), the connector is simply inactive; a
# placeholder value is rejected rather than sent.
SEC_USER_AGENT=
SEC_EDGAR_API_BASE_URL=https://data.sec.gov
SEC_EDGAR_WWW_BASE_URL=https://www.sec.gov
# SEC full-text search and XBRL peer ranking run on a different host from
# data.sec.gov, so they carry their own base URL.
SEC_EDGAR_FTS_BASE_URL=https://efts.sec.gov

# World Bank WDI — queried directly as the publisher (trade balance, current
# account, inflation, unemployment, GDP growth, central-government debt) before
# the DBnomics mirror is used. Keyless. Override only for a proxy/test.
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2

# ── FRED (Federal Reserve Economic Data) — key-gated ────────────────────────
# US official statistics: GDP, CPI, unemployment, the federal funds rate, the
# Treasury curve, trade and current-account balances. Register for a free key at
# https://fredaccount.stlouisfed.org/apikeys and never expose it through a
# NEXT_PUBLIC_* variable — app/orchestration/fred.py sends it server-side only.
#
# FRED is the one member of the economic-data block above that needs a
# credential; with the key blank the connector simply returns nothing rather
# than guessing. The base URL is overridable for a proxy, and the code refuses a
# malformed value (e.g. a key accidentally pasted onto the end of the URL).
FRED_API_KEY=YOUR_FRED_API_KEY
FRED_API_BASE_URL=https://api.stlouisfed.org/fred

# ── Market and company data ──────────────────────────────────────────────────
# All optional and independent: each provider is skipped when its key is blank,
# so you can enable one without the others. Backend-only — never expose any of
# these to the frontend and never prefix them with NEXT_PUBLIC_.
#
# Companies House — official UK company register and statutory filings. Free.
#   Register: https://developer.company-information.service.gov.uk/
#   Note: authenticates as HTTP Basic with the key as the USERNAME, not a
#   Bearer token. The adapter handles that; you only paste the key.
COMPANIES_HOUSE_API_KEY=
#
# Finnhub — global quotes, company profiles, fundamentals. Free tier available.
#   Register: https://finnhub.io/register
FINNHUB_API_KEY=
#
# Polygon.io — US price history and ticker reference. Free tier is END OF DAY
# only; realtime needs a paid plan.
#   Register: https://polygon.io/dashboard/signup
POLYGON_API_KEY=
#
# Alpha Vantage — global quotes, OHLCV history, company overview. Free tier is
# roughly 25 calls PER DAY, so it is configured as a last-resort fallback.
#   Register: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
#
# Base URLs for the four key-gated providers above. These are the endpoints the
# adapters actually request, declared here so the full live-data surface is
# visible in one place; the code falls back to these same values if they are
# removed, and they are only overridden for a proxy, test or regional endpoint.
FINNHUB_API_BASE_URL=https://finnhub.io/api/v1
POLYGON_API_BASE_URL=https://api.polygon.io
ALPHA_VANTAGE_API_BASE_URL=https://www.alphavantage.co
# UK register only. Filings questions naming any other supported country are
# refused rather than answered from here.
COMPANIES_HOUSE_API_BASE_URL=https://api.company-information.service.gov.uk

# Entitlement declarations. The provider APIs do not report which plan a key is
# on, so these are operator-declared. Leave false unless your plan really does
# include realtime — a delayed quote presented as realtime is exactly the kind
# of unverifiable claim this product exists to avoid.
FINNHUB_REALTIME=false
POLYGON_REALTIME=false

# Optional: override provider order per intent, e.g.
#   MARKET_DATA_PRIORITY_STOCK_QUOTE=polygon,finnhub
# Defaults live in app/domains/market_data/registry.py.

# Optional tuning for the shared provider HTTP client (seconds).
STOCK_WS_RECONNECT_DELAY=0.5
STOCK_WS_MAX_RECONNECT_DELAY=8

# Hard ceiling for the combined currency, statistics and market-data fan-out.
# Completed sources are kept; unfinished providers are cancelled at this limit.
LIVE_DATA_TIMEOUT_SECONDS=12

# Agent mode: the model fetches live figures through governed tools as it needs
# them (exchange rates, economic statistics, market data, calculator, charts)
# instead of every question pre-fetching every connector. Groq only; any agent
# failure falls back to the standard answer path. Each step re-sends the
# prompt, so expect ~2-4x the tokens of a standard answer (watch Groq TPM).
# Evaluate before enabling: .venv/bin/python scripts/run_agent_eval.py
KRITON_AGENT_MODE=false
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SECONDS=75

# Optional fallback — needs real billing on the account.
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

# Current Groq production defaults. Override only with model IDs enabled for
# your Groq project; see https://console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_ANSWER_MODEL=openai/gpt-oss-20b
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b

OBJECT_STORAGE_URL=
OBJECT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_BUCKET=kriton-documents
ARTIFACT_STORAGE_BUCKET=kriton-artifacts
SIGNED_URL_EXPIRY_SECONDS=300
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ASYNC_DOCUMENT_INGESTION=false
# Use redis://localhost:6379/2 for shared limits across multiple API workers.
RATE_LIMIT_STORAGE_URI=memory://
MODEL_PROVIDER_CONCURRENCY=8
DOCUMENT_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=7
FAILED_UPLOAD_RETENTION_HOURS=24
RETENTION_CLEANUP_BATCH_SIZE=200

# ── Optional tuning overrides ────────────────────────────────────────────────
# Every variable below is read by production code and already has a working
# code default, so this whole block can stay as-is. It is documented rather than
# omitted because an env var that is read but appears in neither file is
# indistinguishable from one that does not exist: an operator reading this file
# cannot tell "unset, using the default" from "not a real setting".
#
# The numeric parsers (ANSWER_CACHE_TTL_SECONDS, GROUNDED_CONTEXT_CHAR_BUDGET,
# OECD_TAX_MAX_AGE_YEARS) fall back to the same defaults on a blank or
# unparseable value, so leaving any of these empty is safe.
#
# Answer cache. ANSWER_CACHE_REDIS_URL falls back to SEARXNG_CACHE_REDIS_URL,
# then REDIS_URL, then the built-in default. Volatile freshness classes (quotes,
# index levels) are excluded from this cache entirely rather than aged out.
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_REDIS_URL=
REDIS_URL=
# Model used for the one-word risk classification call. Empty reuses
# GEMINI_MODEL; that call only runs when GEMINI_API_KEY is set.
GEMINI_CLASSIFIER_MODEL=
# Character budget for assembled grounded context. Lower values truncate the
# evidence; the code clamps anything below 2000 back up to it.
GROUNDED_CONTEXT_CHAR_BUDGET=6000
# Freshness control for the OECD/DBnomics corporation-tax connector. A tax year
# older than this is refused rather than presented as a current rate.
OECD_TAX_MAX_AGE_YEARS=1
# Per-request ceiling for source retrieval.
SOURCE_RETRIEVAL_TIMEOUT_SECONDS=20
# Debug/ops switches. Both are off by default and are read as truthy strings.
QUERY_CLASSIFIER_SHADOW_MODE=
KRITON_ALWAYS_SEND_VISUAL_RULES=
# Opt-in company-equity adapter over Yahoo. Leave YAHOO_EQUITY_ENABLED unset (or
# 0/false) to keep company quotes on the key-gated providers only: this adapter
# needs no credential, so reporting itself configured would silently route every
# company question to a third party the operator never chose.
# YAHOO_EQUITY_ENABLED=1
# YAHOO_EQUITY_API_BASE_URL=https://query1.finance.yahoo.com
# Per-provider User-Agent overrides for the keyless official statistics APIs.
# The SEC and BoE/CDS services require an identifying User-Agent with real
# contact details; a working default ships in the code, so these only override
# the contact details shown to them. Must be a monitored mailbox.
# BOE_USER_AGENT=Your App admin@example.com
# BANK_OF_CANADA_USER_AGENT=Your App admin@example.com
# RBA_USER_AGENT=Your App admin@example.com
