# Use the Session Pooler string from Supabase (Project Settings → Database →
# Connection String → "Session pooler"), not the direct db.<ref>.supabase.co
# host — that one is IPv6-only and unreliable on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Non-superuser role for request-time queries (auto-created on first boot).
APP_DATABASE_URL=postgresql://zoiko_app.<project-ref>:<a-password-you-choose>@aws-0-<region>.pooler.supabase.com:5432/postgres

ENABLE_ML_CLASSIFIER=true

# Testing only — see warning in RUNNING_KRITON.md.
FORCE_DIRECT_ANSWER=true

# Supabase Auth — Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is
# secret: server-side only, never send it to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# console.groq.com
GROQ_API_KEY=<gsk_...>
# Model used for answer composition. If Groq returns "model_decommissioned",
# check console.groq.com/docs/models (e.g. llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (aistudio.google.com). When set, Gemini answers questions
# (more reliable charts/diagrams) and Groq becomes the fallback + risk
# classifier. Leave GEMINI_API_KEY blank to keep answering on Groq.
# Use a model id your key can access: models?key=<key> — e.g. gemini-2.5-flash.
GEMINI_API_KEY=<AI...>
GEMINI_MODEL=gemini-flash-latest

# SearXNG instance for live web-search grounding (Ask Kriton sources).
# Run one locally: docker run -d -p 8888:8080 searxng/searxng (enable the
# JSON format in its settings.yml). Leave default if running via docker-compose.
SEARXNG_URL=http://localhost:8888
# Set true to only ever use trusted-domain results (no general-web fallback).
SEARXNG_STRICT_ALLOWLIST=false

# Exact-figure grounding — free, keyless, public URLs (no API key needed).
# DBnomics aggregates ~90 official statistics providers (World Bank, IMF, OECD,
# ECB, ILO…) for economic figures; Frankfurter serves ECB currency rates.
DBNOMICS_API_BASE_URL=https://api.db.nomics.world/v22
FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev/v1

# Optional fallback — needs real billing on the account.
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

OBJECT_STORAGE_URL=
CELERY_BROKER_URL=
