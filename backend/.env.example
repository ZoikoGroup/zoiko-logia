# Use the Session Pooler string from Supabase (Project Settings → Database →
# Connection String → "Session pooler"), not the direct db.<ref>.supabase.co
# host — that one is IPv6-only and unreliable on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Non-superuser role for request-time queries (auto-created on first boot).
APP_DATABASE_URL=postgresql://zoiko_app.<project-ref>:<a-password-you-choose>@aws-0-<region>.pooler.supabase.com:5432/postgres

ENABLE_RAG_EMBEDDINGS=true
LOCAL_VECTOR_STORE_DIR=./vector_store
# Optional local Transformers classifier. Keep disabled until the model has
# been verified against the deployment's memory and native-library stack.
# Deterministic L1/L2 safety checks remain active when this is false.
ENABLE_ML_CLASSIFIER=false
ENABLE_LIVE_SOURCES=true
LIVE_SOURCE_HTTP_TIMEOUT_SECONDS=20
LIVE_SOURCE_MAX_ATTEMPTS=2
LIVE_SOURCE_RETRY_BACKOFF_SECONDS=0.25
CLASSIFIER_CONFIDENCE_THRESHOLD=0.35
CLASSIFIER_ZERO_CONFIDENCE_THRESHOLD=0.50
CLASSIFIER_LOW_CONFIDENCE_THRESHOLD=0.35
CLASSIFIER_MEDIUM_CONFIDENCE_THRESHOLD=0.35
CLASSIFIER_HIGH_CONFIDENCE_THRESHOLD=0.30

# Risk-classifier rollout: off | fallback | shadow.
# fallback calls the schema-constrained OpenAI classifier only when the local
# model is unavailable/uncertain. shadow compares both classifiers but keeps a
# confident local decision. Start with shadow, review metrics, then use fallback.
RISK_LLM_CLASSIFIER_MODE=off
RISK_LLM_CLASSIFIER_MODEL=gpt-4o-mini
RISK_LLM_CLASSIFIER_TIMEOUT_SECONDS=8
# Query understanding uses the same schema-constrained classification result.
# Clear queries stay local; only uncertain fallback-mode queries wait for this
# smaller orchestration budget before continuing with deterministic metadata.
QUERY_UNDERSTANDING_REMOTE_TIMEOUT_SECONDS=1.25
QUERY_UNDERSTANDING_CACHE_TTL_SECONDS=900
QUERY_UNDERSTANDING_CACHE_MAX_ENTRIES=1024

# Runs policyengine-us in-process for real EITC/CTC/standard-deduction/
# federal-income-tax/CA&NY-state-income-tax calculations (no external API,
# no key) instead of leaving the LLM to guess numbers — see
# app/domains/calculation/. Heavy dependency (numpy/pandas + large
# parameter tree, ~15s one-time import cost on first use); disable if
# cold-start time/footprint matters more than real numeric answers.
ENABLE_TAX_CALCULATION_ENGINE=true

# DANGER — bypasses the real HIGH-risk -> human-review safeguard entirely.
# Testing only, see RUNNING_KRITON.md. Defaults to false here (unlike the
# other flags above) so a fresh setup must deliberately opt in rather than
# deliberately opt out — leave this off unless you specifically need it.
FORCE_DIRECT_ANSWER=false
# Two-key safeguard: FORCE_DIRECT_ANSWER is ignored unless both values below
# explicitly identify an isolated developer environment.
APP_ENV=development
ALLOW_UNSAFE_DEV_OVERRIDES=false

# Supabase Auth — Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is
# secret: server-side only, never send it to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# console.groq.com
GROQ_API_KEY=<gsk_...>

# Optional fallback — needs real billing on the account.
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

# Optional — cloud fallback parser when Docling fails on a document.
LLAMA_CLOUD_API_KEY=<llx-...>

VECTOR_INDEX_URL=
OBJECT_STORAGE_URL=
CELERY_BROKER_URL=

# Public, no-auth API — no key needed. Defaults to the real endpoint if unset.
TREASURY_FISCAL_DATA_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v1

# payrolltaxapi.com — keyed, metered (free tier: 1,000 req/month, 20/min).
PAYROLL_TAX_API_BASE_URL=https://payrolltaxapi.com/v1
PAYROLL_TAX_API_KEY=

# US Census Bureau — free with registration at https://api.census.gov/data/key_signup.html
CENSUS_API_BASE_URL=https://api.census.gov/data
CENSUS_API_KEY=

# US Bureau of Labor Statistics Public Data API (CPI/inflation) — free
# without registration at low rate limits, registration raises them.
BLS_API_BASE_URL=https://api.bls.gov/publicAPI/v2
BLS_API_KEY=

# US Bureau of Economic Analysis API (GDP / NIPA) — free with registration
# at https://apps.bea.gov/API/signup/
BEA_API_BASE_URL=https://apps.bea.gov/api/data
BEA_API_KEY=

# Federal Reserve Economic Data (FRED) — free with registration at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_BASE_URL=https://api.stlouisfed.org/fred
FRED_API_KEY=

# US Government Publishing Office GovInfo API — free with registration at
# https://api.govinfo.gov/docs/ (sign up via api.data.gov)
GOVINFO_API_BASE_URL=https://api.govinfo.gov
GOVINFO_API_KEY=

# Federal Register API — fully public, no key required.
FEDERAL_REGISTER_API_BASE_URL=https://www.federalregister.gov/api/v1

# eCFR (Electronic Code of Federal Regulations) API — fully public, no key required.
ECFR_API_BASE_URL=https://www.ecfr.gov/api/versioner/v1

# SEC EDGAR public data — identify the application and monitored contact.
SEC_DATA_API_BASE_URL=https://data.sec.gov
SEC_USER_AGENT=Kriton contact@example.com

# Congress.gov public legislative API.
CONGRESS_API_BASE_URL=https://api.congress.gov/v3
CONGRESS_API_KEY=

# Regulations.gov federal rulemaking and docket API.
REGULATIONS_GOV_API_BASE_URL=https://api.regulations.gov/v4
REGULATIONS_GOV_API_KEY=

# Phase 1 authoritative live sources. ECB, IMF, and VIES are keyless;
# endpoints remain configurable for testing and controlled migrations.
ECB_API_BASE_URL=https://data-api.ecb.europa.eu/service
IMF_API_BASE_URL=https://www.imf.org/external/datamapper/api/v2
VIES_API_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
CELLAR_SPARQL_URL=https://publications.europa.eu/webapi/rdf/sparql
# Cellar queries a very large public graph and legitimately exceeds the
# shared live-source budget; given its own rather than raising the global one.
CELLAR_SPARQL_TIMEOUT_SECONDS=60
LEGISLATION_GOV_UK_BASE_URL=https://www.legislation.gov.uk
# legislation.gov.uk answers with HTTP 202 while it builds the Atom feed.
# Poll ladder in seconds; the total must stay inside the request budget.
LEGISLATION_GOV_UK_RETRY_DELAYS=0.5,1.0,2.0,4.0
TED_API_BASE_URL=https://api.ted.europa.eu/v3
SAM_GOV_OPPORTUNITIES_URL=https://api.sam.gov/opportunities/v2/search
SAM_GOV_API_KEY=
OFAC_SDN_XML_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
UN_SANCTIONS_XML_URL=https://scsanctions.un.org/resources/xml/en/name/consolidated.xml
UK_SANCTIONS_CSV_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.csv
# Current official EU FSF CSV distribution; keep configurable for catalogue migrations.
EU_SANCTIONS_CSV_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/csvFullSanctionsList/content
# Comma-separated alternate distributions, tried in order after the primary
# fails. OFAC and the EU FSF returned 403 to some deployment networks; a 403
# caused by egress rather than by the address needs a network fix, not these.
OFAC_SDN_XML_FALLBACK_URLS=https://www.treasury.gov/ofac/downloads/sdn.xml
UN_SANCTIONS_XML_FALLBACK_URLS=
UK_SANCTIONS_CSV_FALLBACK_URLS=
EU_SANCTIONS_CSV_FALLBACK_URLS=
# Sent on every official-feed download. Append a real contact address.
SANCTIONS_FEED_USER_AGENT=Kriton/1.0 (authoritative-source-monitor)
# Similarity floor for a fuzzy screening candidate. Lower finds more, at the
# cost of a review queue nobody can work through.
SANCTIONS_FUZZY_MATCH_THRESHOLD=0.88
SANCTIONS_SNAPSHOT_TTL_SECONDS=3600
SANCTIONS_MAX_DOWNLOAD_BYTES=75000000
# Must be persistent and shared between the Celery worker (writes) and the
# API (reads). On an ephemeral filesystem, snapshots vanish on redeploy and
# screening silently returns to failing closed.
SANCTIONS_SNAPSHOT_DIR=./data/live_sources
SANCTIONS_ALLOW_INLINE_REFRESH=false

# Optional commercial ZIP-level tax lookup; confirm endpoint and licence.
ZIPTAX_API_BASE_URL=
ZIPTAX_API_KEY=
