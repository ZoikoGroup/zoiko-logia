# Use the Session Pooler string from Supabase (Project Settings → Database →
# Connection String → "Session pooler"), not the direct db.<ref>.supabase.co
# host — that one is IPv6-only and unreliable on most networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Non-superuser role for request-time queries (auto-created on first boot).
APP_DATABASE_URL=postgresql://zoiko_app.<project-ref>:<a-password-you-choose>@aws-0-<region>.pooler.supabase.com:5432/postgres

ENABLE_ML_CLASSIFIER=true

# Testing only — see warning in RUNNING_KRITON.md.
FORCE_DIRECT_ANSWER=true

# Supabase Auth — Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is
# secret: server-side only, never send it to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# console.groq.com
GROQ_API_KEY=<gsk_...>
# Model used for answer composition. If Groq returns "model_decommissioned",
# check console.groq.com/docs/models (e.g. llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (aistudio.google.com). When set, Gemini answers questions
# (more reliable charts/diagrams) and Groq becomes the fallback + risk
# classifier. Leave GEMINI_API_KEY blank to keep answering on Groq.
# Use a model id your key can access: models?key=<key> — e.g. gemini-2.5-flash.
GEMINI_API_KEY=<AI...>
GEMINI_MODEL=gemini-flash-latest

# SearXNG instance for live web-search grounding (Ask Kriton sources).
# Run one locally: docker run -d -p 8888:8080 searxng/searxng (enable the
# JSON format in its settings.yml). Leave default if running via docker-compose.
SEARXNG_URL=http://localhost:8888
# Set true to only ever use trusted-domain results (no general-web fallback).
SEARXNG_STRICT_ALLOWLIST=false

# Exact-figure grounding — free, keyless, public URLs (no API key needed).
# DBnomics aggregates ~90 official statistics providers (World Bank, IMF, OECD,
# ECB, ILO…) for economic figures; Frankfurter serves ECB currency rates.
DBNOMICS_API_BASE_URL=https://api.db.nomics.world/v22
FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev/v1

# Official UK legislation. Public and keyless; override only for a proxy/test.
LEGISLATION_API_BASE_URL=https://www.legislation.gov.uk

# SEC EDGAR — US registrants' own filed financials (revenue, net income, total
# assets, EPS…), taken from their 10-K XBRL facts. Free and keyless, but the
# SEC's access policy REQUIRES a User-Agent naming you with real contact
# details, and blocks traffic without one. Set this to your own app + email;
# left blank, the connector stays silent rather than risking an IP-level block
# on a shared egress address.
# Format: "<Company or app name> <admin-contact-email>", e.g.
#   SEC_USER_AGENT=ZoikoLogia Kriton ops@zoikogroup.com
# Must be a real, monitored mailbox — it is how the SEC contacts you before
# blocking. Left blank (as here), the connector is simply inactive; a
# placeholder value is rejected rather than sent.
SEC_USER_AGENT=
SEC_EDGAR_API_BASE_URL=https://data.sec.gov
SEC_EDGAR_WWW_BASE_URL=https://www.sec.gov

# ── Market and company data ──────────────────────────────────────────────────
# All optional and independent: each provider is skipped when its key is blank,
# so you can enable one without the others. Backend-only — never expose any of
# these to the frontend and never prefix them with NEXT_PUBLIC_.
#
# Companies House — official UK company register and statutory filings. Free.
#   Register: https://developer.company-information.service.gov.uk/
#   Note: authenticates as HTTP Basic with the key as the USERNAME, not a
#   Bearer token. The adapter handles that; you only paste the key.
COMPANIES_HOUSE_API_KEY=
#
# Finnhub — global quotes, company profiles, fundamentals. Free tier available.
#   Register: https://finnhub.io/register
FINNHUB_API_KEY=
#
# Polygon.io — US price history and ticker reference. Free tier is END OF DAY
# only; realtime needs a paid plan.
#   Register: https://polygon.io/dashboard/signup
POLYGON_API_KEY=
#
# Alpha Vantage — global quotes, OHLCV history, company overview. Free tier is
# roughly 25 calls PER DAY, so it is configured as a last-resort fallback.
#   Register: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Entitlement declarations. The provider APIs do not report which plan a key is
# on, so these are operator-declared. Leave false unless your plan really does
# include realtime — a delayed quote presented as realtime is exactly the kind
# of unverifiable claim this product exists to avoid.
FINNHUB_REALTIME=false
POLYGON_REALTIME=false

# Optional: override provider order per intent, e.g.
#   MARKET_DATA_PRIORITY_STOCK_QUOTE=polygon,finnhub
# Defaults live in app/domains/market_data/registry.py.

# Optional tuning for the shared provider HTTP client (seconds).
STOCK_WS_RECONNECT_DELAY=0.5
STOCK_WS_MAX_RECONNECT_DELAY=8

# Optional fallback — needs real billing on the account.
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

OBJECT_STORAGE_URL=
OBJECT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_BUCKET=kriton-documents
ARTIFACT_STORAGE_BUCKET=kriton-artifacts
SIGNED_URL_EXPIRY_SECONDS=300
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ASYNC_DOCUMENT_INGESTION=false
# Use redis://localhost:6379/2 for shared limits across multiple API workers.
RATE_LIMIT_STORAGE_URI=memory://
MODEL_PROVIDER_CONCURRENCY=8
DOCUMENT_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=7
FAILED_UPLOAD_RETENTION_HOURS=24
RETENTION_CLEANUP_BATCH_SIZE=200
