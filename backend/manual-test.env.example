# Isolated manual-test server settings (scripts/run_manual_test_server.py).
# Copy to a file NOT named .env (e.g. .env.manual-test, which git ignores).
# Every database and cache here must be dedicated to manual testing.

# A dedicated PostgreSQL database, set up with scripts/setup_database.py,
# holding the marker row below. Owner/setup role:
KRITON_TEST_DATABASE_URL=postgresql://kriton_test_owner:CHANGE_ME@127.0.0.1:5432/kriton_manual_test
# Same database, a separate role that is not a superuser and has no BYPASSRLS
# (setup_database.py creates it from this URL):
KRITON_TEST_APP_DATABASE_URL=postgresql://kriton_test_app:CHANGE_ME@127.0.0.1:5432/kriton_manual_test
# Random, at least 16 characters; the same value is inserted into
# kriton_test_environment when the database is provisioned.
KRITON_TEST_DATABASE_MARKER=
# A Redis database index no other server uses (the shared caches use 3).
KRITON_TEST_REDIS_URL=redis://localhost:6379/9

# Optional: a separate Supabase project for sign-in. Unset = tokens are
# verified against the shared project's public keys and the test server gets
# NO service-role key, so it cannot change accounts there.
# KRITON_TEST_SUPABASE_URL=
# KRITON_TEST_SUPABASE_SERVICE_ROLE_KEY=

# Session limits, enforced by the server (defaults shown).
# KRITON_TEST_MAX_QUESTIONS=12
# KRITON_TEST_MAX_TOTAL_TOKENS=300000
# Health samples (written to the test database only). Default off.
# KRITON_TEST_HEALTH_SAMPLER=false
# Agent settings for this server only (defaults shown).
# KRITON_TEST_AGENT_MAX_TOKENS=128000
# KRITON_TEST_AGENT_MAX_COMPLETION_TOKENS=8192
# KRITON_TEST_AGENT_MAX_REQUEST_TOKENS=16000
# KRITON_TEST_AGENT_BATCH_CALCULATIONS=true
